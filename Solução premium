<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LUXCOR - MVP Imobiliário</title>
    <!-- Tailwind CSS para Estilização Rápida e Responsiva -->
    <script src="https://tailwindcss.com"></script>
    <!-- Lucide Icons para Vetores Limpos -->
    <script src="https://unpkg.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- AVISO DE FILTRO DE AMBIENTE (MVP FRONT-END) -->
    <div class="bg-amber-500 text-amber-950 px-4 py-1 text-xs text-center font-medium shadow-inner">
        ⚠️ <strong>Modo MVP Front-end:</strong> Os dados são salvos temporariamente no seu navegador (localStorage). Para produção, é fundamental implementar infraestrutura dedicada (banco de dados, autenticação robusta, armazenamento de arquivos, APIs oficiais de pagamento e WhatsApp).
    </div>

    <!-- HEADER / NAVEGAÇÃO -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2 cursor-pointer" onclick="switchView('public-catalog')">
                <div class="bg-indigo-600 text-white p-2 rounded-lg shadow-md shadow-indigo-200">
                    <i data-lucide="home" class="w-6 h-6"></i>
                </div>
                <span class="text-xl font-bold tracking-tight text-slate-900">LUXCOR</span>
            </div>
            <nav class="flex items-center gap-4">
                <button onclick="switchView('public-catalog')" class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors px-3 py-2 rounded-md">
                    Catálogo Público
                </button>
                <button id="nav-dashboard-btn" onclick="switchView('login-screen')" class="flex items-center gap-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition-all px-4 py-2 rounded-lg shadow-sm">
                    <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                    <span id="nav-dashboard-text">Painel Corretor</span>
                </button>
                <button id="logout-btn" onclick="handleLogout()" class="hidden text-sm font-medium text-rose-600 hover:bg-rose-50 px-3 py-2 rounded-md transition-colors">
                    Sair
                </button>
            </nav>
        </div>
    </header>

    <!-- CONTAINER PRINCIPAL DE TELAS -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- 1. TELA: CATÁLOGO PÚBLICO -->
        <section id="view-public-catalog" class="space-y-8 dynamic-view">
            <div class="text-center max-w-2xl mx-auto space-y-3">
                <h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl tracking-tight">Encontre o seu imóvel ideal</h1>
                <p class="text-slate-500 text-base">Explore nossas listagens exclusivas atualizadas em tempo real pela nossa equipe de corretores.</p>
            </div>
            
            <!-- Grid de Imóveis -->
            <div id="public-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Inserido dinamicamente via JS -->
            </div>
            
            <div id="catalog-empty-state" class="hidden text-center py-12 bg-white rounded-xl border border-dashed border-slate-300">
                <i data-lucide="building-2" class="w-12 h-12 text-slate-400 mx-auto mb-3"></i>
                <p class="text-slate-500 font-medium">Nenhum imóvel disponível no catálogo no momento.</p>
            </div>
        </section>


        <!-- 2. TELA: DETALHE PÚBLICO DO IMÓVEL (PÁGINA PÚBLICA GERADA) -->
        <section id="view-public-detail" class="hidden dynamic-view space-y-6">
            <button onclick="switchView('public-catalog')" class="flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Voltar ao catálogo
            </button>
            
            <div id="property-detail-container" class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm grid grid-cols-1 lg:grid-cols-3">
                <!-- Inserido dinamicamente via JS -->
            </div>
        </section>


        <!-- 3. TELA: LOGIN DEMO -->
        <section id="view-login-screen" class="hidden dynamic-view max-w-md mx-auto my-12">
            <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-xl space-y-6">
                <div class="text-center space-y-2">
                    <h2 class="text-2xl font-bold text-slate-900">Acesso Restrito</h2>
                    <p class="text-xs text-slate-500">Insira as credenciais de demonstração abaixo para acessar o painel administrativo.</p>
                </div>
                
                <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs space-y-1 text-slate-600">
                    <p><strong>Usuário:</strong> admin</p>
                    <p><strong>Senha:</strong> admin123</p>
                </div>

                <form onsubmit="handleLogin(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Usuário</label>
                        <input id="login-user" type="text" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Senha</label>
                        <input id="login-pass" type="password" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm">
                    </div>
                    <div id="login-error" class="hidden text-xs text-rose-600 font-medium bg-rose-50 p-2 rounded border border-rose-200">
                        Credenciais incorretas. Tente novamente.
                    </div>
                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-lg transition-colors shadow-sm text-sm">
                        Entrar no Painel
                    </button>
                </form>
            </div>
        </section>


        <!-- 4. TELA: PAINEL / DASHBOARD ADMINISTRATIVO -->
        <section id="view-dashboard" class="hidden dynamic-view space-y-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-5">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">Painel de Controle</h1>
                    <p class="text-sm text-slate-500">Gerencie a carteira de imóveis do MVP LUXCOR.</p>
                </div>
                <button onclick="openModal()" class="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-lg font-medium text-sm transition-all shadow-sm">
                    <i data-lucide="plus" class="w-4 h-4"></i> Novo Imóvel
                </button>
            </div>

            <!-- Cards de Métricas Rápidas -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
                    <div class="p-3 bg-indigo-50 text-indigo-600 rounded-lg"><i data-lucide="building" class="w-6 h-6"></i></div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium uppercase tracking-wider">Total de Imóveis</p>
                        <p id="stat-total" class="text-2xl font-bold text-slate-900">0</p>
                    </div>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
                    <div class="p-3 bg-emerald-50 text-emerald-600 rounded-lg"><i data-lucide="coins" class="w-6 h-6"></i></div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium uppercase tracking-wider">Disponíveis p/ Venda</p>
                        <p id="stat-venda" class="text-2xl font-bold text-slate-900">0</p>
                    </div>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
                    <div class="p-3 bg-blue-50 text-blue-600 rounded-lg"><i data-lucide="key-round" class="w-6 h-6"></i></div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium uppercase tracking-wider">Disponíveis p/ Locação</p>
                        <p id="stat-locacao" class="text-2xl font-bold text-slate-900">0</p>
                    </div>
                </div>
            </div>

            <!-- Tabela Administrativa de Imóveis -->
            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                <div class="px-5 py-4 border-b border-slate-200 bg-slate-50/50">
                    <h3 class="font-semibold text-slate-900 text-sm">Imóveis Cadastrados</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="border-b border-slate-200 text-slate-400 text-xs font-semibold uppercase tracking-wider bg-slate-50/70">
                                <th class="py-3 px-5">Título / Localização</th>
                                <th class="py-3 px-5">Modalidade</th>
